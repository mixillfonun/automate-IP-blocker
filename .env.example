# Required secrets
ABUSEIPDB_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_LIST_ID=

# Runtime paths
NGINX_ACCESS_LOG=/var/log/nginx/example.access.log
SQLITE_PATH=./data/reputation.db

# Reputation policy
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_CACHE_HOURS=24
BLOCK_THRESHOLD=90
MONITOR_THRESHOLD=80
BLOCK_TTL_DAYS=30
RECHECK_INTERVAL_DAYS=7

# Safety: keep true until integration testing is complete
DRY_RUN=true
